# ─────────────────────────────────────────────
#  VentaCore — Variables de entorno (PRODUCCIÓN)
#  Copiar a .env.production y completar TODOS los campos.
#    cp .env.production.template .env.production
#  .env.production está en .gitignore: NUNCA lo subas al repo.
# ─────────────────────────────────────────────

NODE_ENV=production

# ── API (NestJS) ──
API_PORT=3000
API_PREFIX=api

# ── Postgres (TypeORM) ──
# DB_PASSWORD lo genera setup-server.sh y lo imprime al final. Copiarlo de ahí.
DB_HOST=localhost
DB_PORT=5432
DB_USER=ventacore
DB_PASSWORD=
DB_NAME=ventacore
# synchronize=true deja que TypeORM altere el esquema solo en cada arranque.
# Sirve para el primer deploy, con la base vacía. Una vez que haya datos
# reales, poner false y usar migraciones: un cambio de entidad puede
# borrar columnas sin aviso.
DB_SYNCHRONIZE=true

# ── Firebase Admin (API) ──
# Ruta al archivo service-account.json descargado de Firebase Console.
# Ese archivo es un secreto: copiarlo al server por scp, nunca commitearlo.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/ventacore/firebase-service-account.json
# Bucket de Storage: el API sube ahí la foto del handoff (subir desde el
# celular vía QR). Mismo valor que VITE_FIREBASE_STORAGE_BUCKET. Ej: proyecto.appspot.com
# NO poner FIREBASE_STORAGE_EMULATOR_HOST en prod (eso es solo de dev).
FIREBASE_STORAGE_BUCKET=

# ── Meta (Facebook + Instagram) ──
# La app de Meta es ÚNICA de plataforma: se registra UNA vez (developers.facebook.com)
# y todos los negocios la autorizan con su Página/IG (OAuth). Para que negocios de
# afuera puedan conectar, la app debe estar en modo Live + App Review aprobado
# (instagram_content_publish, pages_manage_posts, etc.) + verificación de negocio.
# META_TOKEN_ENC_KEY es SECRETO: nunca commitear .env.production.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Callback del API (debe coincidir EXACTO con el registrado en la app de Meta).
META_REDIRECT_URI=https://TU_DOMINIO/api/meta/callback
# A dónde vuelve el navegador tras conectar (panel admin).
META_POST_CONNECT_REDIRECT=https://TU_DOMINIO/admin/configuraciones
# Clave AES-256 para cifrar los tokens en la base. Generar UNA nueva y estable:
#   openssl rand -base64 32
# Si cambia, los tokens ya guardados dejan de poder descifrarse (hay que reconectar).
META_TOKEN_ENC_KEY=

# ── Mercado Libre ──
# La app de ML es ÚNICA de plataforma: se registra UNA vez y todos los negocios
# la autorizan con su cuenta (OAuth). App ID (client_id) + Client Secret de esa
# app; el callback debe coincidir EXACTO con el registrado en la app de ML.
ML_APP_ID=
ML_APP_SECRET=
ML_REDIRECT_URI=https://TU_DOMINIO/api/ml/callback
ML_POST_CONNECT_REDIRECT=https://TU_DOMINIO/admin/configuraciones
# Host de consentimiento según el sitio del vendedor (MLA → .com.ar, MLB → .com.br, etc.).
ML_AUTH_HOST=https://auth.mercadolibre.com.ar
ML_API_HOST=https://api.mercadolibre.com

# ── Cobros / Suscripciones (Lemon Squeezy; luego Mercado Pago) ──
# Modelo BYO: cada negocio carga su API key / store id / signing secret desde
# el panel (Cobros); se guardan CIFRADOS en la DB con META_TOKEN_ENC_KEY (la
# misma clave de arriba). No van acá.
# URL pública del API: se usa para armar la URL de webhook que el negocio pega
# en Lemon Squeezy. Debe ser el dominio real del API (con https), SIN barra final.
PUBLIC_API_URL=https://TU_DOMINIO

# ── Frontend (Vite) ──
# En producción Nginx hace proxy, asi que la URL es relativa.
VITE_API_URL=/api
VITE_BASE_PATH=/

# ── Firebase Web SDK (Frontend) ──
# Obtener de Firebase Console > Project Settings > General > Your apps
# Estas VITE_* viajan al bundle del navegador por diseño: no son secretos.
# Firebase se protege con Security Rules, no ocultando estas claves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
